# DeyeView does not need a server secret.
# Inverter credentials are typed into the app and stored on the device.
# Native release signing is configured in the store publishing guide.

# Optional AdMob overrides. Leave these commented to keep the live ids in src/config/ads.ts.
# App ids are copied into the Android and iOS projects by `npm run build`.
# Banner ids are baked into the web bundle. Do not commit a filled-in .env file.
# Debug builds still request Google's sample banner units. Release builds request the live units
# unless VITE_ADMOB_FORCE_TEST_ADS is true or the hidden Settings test-ads switch is on.

# VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# VITE_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# VITE_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# VITE_ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# VITE_ADMOB_FORCE_TEST_ADS=true

# Register handsets so AdMob serves test creatives on them (AdMob.initialize testingDevices).
# Find the id in logcat or Xcode the first time a live unit is requested.
# Do not set these in a Play production or App Store build.
# VITE_ADMOB_DEBUG_GEOGRAPHY=EEA
# VITE_ADMOB_TEST_DEVICE_IDS=YOUR_TEST_DEVICE_ID
