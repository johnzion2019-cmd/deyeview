# DeyeView does not need a server secret.
# Inverter credentials are typed into the app and stored on the device.
# Native release signing is configured in the store publishing guide.

# Optional AdMob overrides. Leave these commented to keep Google's official test ids
# from src/config/ads.ts. Real ids go here after you create an AdMob account, then run
# `npm run build` and `npx cap sync`. App ids are copied into the Android and iOS projects.
# Banner ids are baked into the web bundle. Do not commit a filled-in .env file.

# VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# VITE_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# VITE_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
# VITE_ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz

# Debug the consent form on a device. Do not set these in a store build.
# VITE_ADMOB_DEBUG_GEOGRAPHY=EEA
# VITE_ADMOB_TEST_DEVICE_IDS=YOUR_TEST_DEVICE_ID
